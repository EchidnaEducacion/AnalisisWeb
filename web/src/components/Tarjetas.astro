---
// Tarjetas de enlace de la página genérica (campo `cards`): título, texto y, si la hay, imagen
import type { ImageMetadata } from 'astro';
import { Image } from 'astro:assets';
import { url } from '../lib/url';

interface Props {
  cards: { title: string; text: string; href: string; image?: ImageMetadata }[];
  /** Columnas: 2 (en la columna del texto) o 3 (a todo el ancho) */
  columnas?: 2 | 3;
}
const { cards, columnas = 2 } = Astro.props;
// Las rutas internas llevan base; las URL externas, no
const enlace = (href: string) => (href.startsWith('/') ? url(href.slice(1)) : href);
---
<ul class={`img-cards grid grid--${columnas}`}>
  {cards.map((c) => (
    <li class="card">
      {c.image && (
        <div class="img-cards__img">
          <Image src={c.image} alt="" widths={[320, 640]} sizes="320px" />
        </div>
      )}
      <div class="card__body">
        <h2 class="card__title"><a class="card__link" href={enlace(c.href)}>{c.title}</a></h2>
        <p class="card__text">{c.text}</p>
      </div>
    </li>
  ))}
</ul>

---
import { url } from '../lib/url';
---
<footer class="site-footer">
  <div class="wrap">
    <div class="footer-grid">
      <div class="footer-about">
        <a class="brand" href={url("maquetas/portada/")} aria-label="Echidna Educación, ir a la portada">
          <svg class="brand__mark" aria-hidden="true"><use href="#i-echidna"/></svg>
          <span class="brand__name"><span class="brand__echidna">Echidna</span>Educación</span>
        </a>
        <p>Asociación sin ánimo de lucro formada por docentes. Promovemos el acceso a la programación y la robótica educativa con hardware y materiales libres.</p>
        <div class="social">
          <a href="https://github.com/EchidnaEducacion" aria-label="GitHub"><svg aria-hidden="true"><use href="#i-github"/></svg></a>
          <a href="https://www.youtube.com/channel/UCYmPpIWazAOc7dLs4CZEqew" aria-label="YouTube"><svg aria-hidden="true"><use href="#i-youtube"/></svg></a>
          <a href="https://x.com/EchidnaSTEAM" aria-label="X (Twitter)"><svg aria-hidden="true"><use href="#i-x"/></svg></a>
          <a href="#" aria-label="RSS del blog"><svg aria-hidden="true"><use href="#i-rss"/></svg></a>
        </div>
      </div>
      <div>
        <h2>Ecosistema</h2>
        <ul>
          <li><a href="#">EchidnaML (descarga)</a></li>
          <li><a href={url("maquetas/ficha-hardware/")}>EchidnaBlack2</a></li>
          <li><a href="https://echidna.es/manual/">Manual</a></li>
          <li><a href="#">Comprobar la placa</a></li>
        </ul>
      </div>
      <div>
        <h2>En el aula</h2>
        <ul>
          <li><a href={url("maquetas/alumnado/")}>Materiales alumnado</a></li>
          <li><a href={url("maquetas/docentes/")}>Recursos docentes</a></li>
          <li><a href="https://echidnaeducacion.github.io/GuiaInicioEchidnaML/">Guía de inicio EchidnaML</a></li>
          <li><a href={url("maquetas/listado/")}>Blog</a></li>
        </ul>
      </div>
      <div>
        <h2>Echidna</h2>
        <ul>
          <li><a href={url("maquetas/pagina/")}>Sobre el proyecto</a></li>
          <li><a href="#">Publicaciones</a></li>
          <li><a href="#">Cómo colaborar</a></li>
          <li><a href="#">Quiero una</a> · <a href={url("maquetas/contacto/")}>Contacta</a></li>
        </ul>
      </div>
    </div>
    <div class="footer-bottom">
      <a class="licenses" href="#" aria-label="Licencias">
        <span>Contenidos CC BY-SA</span><span>Hardware CERN OHL-S</span><span>Software GPL</span>
      </a>
      <div><a href={url("politica-privacidad/")}>Política de privacidad</a> · © 2026 Echidna Educación</div>
    </div>
  </div>
</footer>
<button class="to-top" type="button" aria-label="Volver arriba"><svg aria-hidden="true"><use href="#i-arrow-up"/></svg></button>

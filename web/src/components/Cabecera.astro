---
import { url } from '../lib/url';
// Marca como activa la entrada del menú de la sección actual
interface Props { section?: string }
const { section } = Astro.props;
const activo = (s: string) => (s === section ? ' is-active' : '');
---
<a class="skip-link" href="#contenido">Saltar al contenido</a>
<header class="site-header">
  <div class="wrap site-header__inner">
    <a class="brand" href={url("maquetas/portada/")} aria-label="Echidna Educación, ir a la portada">
      <svg class="brand__mark" aria-hidden="true"><use href="#i-echidna"/></svg>
      <span class="brand__name"><span class="brand__echidna">Echidna</span>Educación</span>
    </a>

    <nav class="nav" aria-label="Principal">
      <ul class="nav__list">
        <li><a class={"nav__link" + activo("ecosistema")} href={url("ecosistema/")}>Ecosistema</a></li>
        <li><a class={"nav__link" + activo("alumnado")} href={url("maquetas/alumnado/")}>Alumnado</a></li>
        <li><a class={"nav__link" + activo("docentes")} href={url("maquetas/docentes/")}>Docentes</a></li>
        <li><a class={"nav__link" + activo("blog")} href={url("blog/")}>Blog</a></li>
        <li class="nav__item--has-sub">
          <button class={"nav__link" + activo("nosotros")} type="button" aria-expanded="false" aria-controls="sub-nosotros">
            Quiénes somos <svg class="chev" aria-hidden="true"><use href="#i-chevron"/></svg>
          </button>
          <ul class="subnav" id="sub-nosotros">
            <li><a href={url("quienes-somos/")}><strong>Sobre el proyecto</strong><span>Quiénes somos y qué hacemos</span></a></li>
            <li><a href={url("contacta/")}><strong>Contacta</strong><span>Escríbenos</span></a></li>
            <li><a href={url("quienes-somos/publicaciones/")}><strong>Publicaciones</strong><span>Echidna en los medios</span></a></li>
          </ul>
        </li>
      </ul>
    </nav>

    <div class="header-actions">
      <button class="search-trigger" type="button" data-open-search>
        <svg aria-hidden="true"><use href="#i-search"/></svg> Buscar <kbd>/</kbd>
      </button>
      <button class="icon-btn search-icon-btn" type="button" data-open-search aria-label="Buscar">
        <svg aria-hidden="true"><use href="#i-search"/></svg>
      </button>
      <div class="lang-switch" role="group" aria-label="Idioma">
        <a href="#" aria-current="true" hreflang="es" lang="es">ES</a>
        <a href="#" hreflang="en" lang="en">EN</a>
      </div>
      <button class="icon-btn theme-toggle" type="button" aria-label="Cambiar entre modo claro y oscuro">
        <svg class="sun" aria-hidden="true"><use href="#i-moon"/></svg>
        <svg class="moon" aria-hidden="true"><use href="#i-sun"/></svg>
      </button>
      <button class="icon-btn menu-toggle" type="button" aria-expanded="false" aria-controls="mobile-nav" aria-label="Abrir menú">
        <svg aria-hidden="true"><use href="#i-menu"/></svg>
      </button>
    </div>
  </div>
</header>

<nav class="mobile-nav" id="mobile-nav" aria-label="Principal (móvil)" hidden>
  <button class="search-trigger mobile-search" type="button" data-open-search>
    <svg aria-hidden="true"><use href="#i-search"/></svg> Buscar en Echidna
  </button>
  <ul>
    <li><a href={url("ecosistema/")}><span class="dot" style="--dot:var(--c-ecosistema)"></span>Ecosistema</a></li>
    <li><a href={url("maquetas/alumnado/")}><span class="dot" style="--dot:var(--c-alumnado)"></span>Alumnado</a></li>
    <li><a href={url("maquetas/docentes/")}><span class="dot" style="--dot:var(--c-docentes)"></span>Docentes</a></li>
    <li><a href={url("blog/")}><span class="dot" style="--dot:var(--c-blog)"></span>Blog</a></li>
    <li><a href={url("quienes-somos/")}><span class="dot" style="--dot:var(--c-nosotros)"></span>Quiénes somos</a>
      <ul>
        <li><a href={url("quienes-somos/")}>Sobre el proyecto</a></li>
        <li><a href={url("contacta/")}>Contacta</a></li>
        <li><a href={url("quienes-somos/publicaciones/")}>Publicaciones</a></li>
      </ul>
    </li>
  </ul>
  <!-- En pantallas estrechas, el idioma y el tema pasan aquí desde la cabecera -->
  <div class="mobile-prefs">
    <div class="lang-switch" role="group" aria-label="Idioma">
      <a href="#" aria-current="true" hreflang="es" lang="es">ES</a>
      <a href="#" hreflang="en" lang="en">EN</a>
    </div>
    <button class="icon-btn theme-toggle" type="button" aria-label="Cambiar entre modo claro y oscuro">
      <svg class="sun" aria-hidden="true"><use href="#i-moon"/></svg>
      <svg class="moon" aria-hidden="true"><use href="#i-sun"/></svg>
    </button>
  </div>
</nav>

<dialog class="search-dialog" id="search-dialog" aria-label="Buscar">
  <form method="dialog" role="search">
    <svg class="icon" aria-hidden="true"><use href="#i-search"/></svg>
    <label class="sr-only" for="q">Buscar en la web</label>
    <input id="q" type="search" placeholder="Busca componentes, materiales, entradas…" autocomplete="off" value="led">
    <button class="icon-btn" value="cancel" aria-label="Cerrar búsqueda"><svg aria-hidden="true"><use href="#i-close"/></svg></button>
  </form>
  <div class="results">
    <!-- Ejemplo de resultados: en Astro los pintará Pagefind -->
    <h3>Ecosistema</h3>
    <ul>
      <li><a href={url("ecosistema/echidnablack2/leds/")}>LEDs ROG <small>Ecosistema › EchidnaBlack2 · Pines D11~, D12 y D13</small></a></li>
    </ul>
    <h3>Materiales alumnado</h3>
    <ul>
      <li><a href={url("maquetas/alumnado/")}>Proyectos de inicio con EchidnaML <small>Materiales alumnado › EchidnaML · Enciende tu primer LED</small></a></li>
    </ul>
    <h3>Blog</h3>
    <ul>
      <li><a href={url("maquetas/entrada-blog/")}>Un semáforo en clase de Tecnología <small>Blog · 12 de marzo de 2024</small></a></li>
    </ul>
  </div>
</dialog>

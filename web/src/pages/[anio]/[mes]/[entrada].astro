---
// Genera una página por cada entrada del blog en su URL de siempre: /AAAA/MM/slug/
import { getCollection, render } from 'astro:content';
import Entrada from '../../../layouts/Entrada.astro';
import { entradasPublicadas, rutaEntrada } from '../../../lib/blog';

export async function getStaticPaths() {
  const todas = await entradasPublicadas();
  // En el servidor de desarrollo, los borradores también tienen su página para revisarlos,
  // pero no salen en los listados ni en el lateral
  const borradores = import.meta.env.DEV ? await getCollection('blog', (e) => e.id.startsWith('es/') && e.data.draft) : [];
  return [...todas, ...borradores].map((entry) => {
    const [anio, mes, entrada] = rutaEntrada(entry).split('/');
    return { params: { anio, mes, entrada }, props: { entry, todas } };
  });
}

const { entry, todas } = Astro.props;
const { Content } = await render(entry);
---
<Entrada entry={entry} todas={todas}>
  <Content />
</Entrada>

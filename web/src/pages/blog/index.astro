---
// Plantilla «Listado» para /blog/: las entradas en dos columnas de tarjetas (imagen arriba, título,
// autor, fecha, categorías y extracto), como en la web anterior, y el lateral del blog.
// Versión básica, pendiente de que el equipo revise el formato del blog: aún sin páginas de
// categoría, etiqueta ni autor, ni paginación.
import { Image } from 'astro:assets';
import { getEntries, getEntry } from 'astro:content';
import Base from '../../layouts/Base.astro';
import BlogLateral from '../../components/BlogLateral.astro';
import { url } from '../../lib/url';
import { entradasPublicadas, fechaLarga, rutaEntrada } from '../../lib/blog';

const todas = await entradasPublicadas();
const entradas = await Promise.all(
  todas.map(async (e) => ({
    entry: e,
    autor: await getEntry(e.data.author),
    categorias: await getEntries(e.data.categories),
  })),
);
---
<Base title="Blog" description="Experiencias de aula, proyectos, talleres y novedades del proyecto Echidna Educación." section="blog">
<main id="contenido">
  <header class="page-hero">
    <div class="wrap">
      <nav class="breadcrumb" aria-label="Migas de pan">
        <ol>
          <li><a href={url()}>Inicio</a></li>
          <li><span aria-current="page">Blog</span></li>
        </ol>
      </nav>
      <h1>Blog</h1>
      <p class="lead">Experiencias de aula, proyectos, talleres y novedades del proyecto.</p>
    </div>
  </header>

  <div class="wrap with-aside">
    <section aria-label="Entradas">
      <ul class="blog-list">
        {entradas.map(({ entry, autor, categorias }) => (
          <li class="card post-card">
            {entry.data.image && (
              <div class="post-thumb">
                <Image src={entry.data.image} alt="" widths={[400, 800]} sizes="(min-width: 960px) 380px, 100vw" />
              </div>
            )}
            <div class="card__body">
              <h2 class="card__title"><a class="card__link" href={url(`${rutaEntrada(entry)}/`)}>{entry.data.title}</a></h2>
              <p class="card__meta">
                {autor.data.name} · <time datetime={entry.data.date.toISOString().slice(0, 10)}>{fechaLarga(entry.data.date)}</time>{' · '}{categorias.map((c) => c.data.name).join(', ')}
              </p>
              <p class="card__text">{entry.data.description}</p>
            </div>
          </li>
        ))}
      </ul>
    </section>

    <BlogLateral todas={todas} />
  </div>
</main>
</Base>

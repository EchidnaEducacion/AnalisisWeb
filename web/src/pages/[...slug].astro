---
// Genera una página por cada entrada de `paginas` en español con las plantillas «Página genérica»,
// «Contacto» e «Índice de sección». La portada se añadirá con su layout.
import { getCollection, render } from 'astro:content';
import Pagina from '../layouts/Pagina.astro';
import Contacto from '../layouts/Contacto.astro';
import Indice from '../layouts/Indice.astro';
import { rutaDe, seccionDe } from '../lib/paginas';
import { rutaHardware } from '../lib/hardware';
import { url } from '../lib/url';

export async function getStaticPaths() {
  const todas = await getCollection('paginas', (p) => p.id.startsWith('es/') && !p.data.draft);
  return todas
    .filter((p) => p.data.template !== 'portada')
    .map((entry) => ({ params: { slug: rutaDe(entry) }, props: { entry, todas } }));
}

const { entry, todas } = Astro.props;
const ruta = rutaDe(entry);
const { Content, headings } = await render(entry);
const fichas = await getCollection('hardware', (h) => h.id.startsWith('es/') && !h.data.draft);

// Migas intermedias: las páginas o fichas de hardware que cuelgan por encima de esta
const tramos = ruta.split('/').slice(0, -1);
const crumbs = tramos.flatMap((_, i) => {
  const padre = tramos.slice(0, i + 1).join('/');
  const p = todas.find((t) => rutaDe(t) === padre) ?? fichas.find((h) => rutaHardware(h) === padre);
  return p ? [{ title: p.data.title, href: url(`${padre}/`) }] : [];
});
---
{entry.data.template === 'indice' ? (
  <Indice
    title={entry.data.title}
    description={entry.data.description}
    section={seccionDe(ruta)}
    crumbs={crumbs}
    ruta={ruta}
    headings={entry.data.toc ? headings : []}
  >
    <Content />
  </Indice>
) : entry.data.template === 'contacto' ? (
  <Contacto
    title={entry.data.title}
    description={entry.data.description}
    section={seccionDe(ruta)}
    crumbs={crumbs}
  >
    <Content />
  </Contacto>
) : (
  <Pagina
    title={entry.data.title}
    description={entry.data.description}
    section={seccionDe(ruta)}
    crumbs={crumbs}
    headings={entry.data.toc ? headings : []}
    team={entry.data.team}
  >
    <Content />
  </Pagina>
)}

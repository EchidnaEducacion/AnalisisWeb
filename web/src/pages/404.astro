---
import { url } from '../lib/url';
import Base from '../layouts/Base.astro';
---
<Base
  title="Página no encontrada"
  description="La página que buscas no existe o ha cambiado de dirección."
>
<main id="contenido">
  <!-- Plantilla: Error 404 -->
  <section class="wrap notfound">
    <svg class="notfound__art" viewBox="0 0 240 120" aria-hidden="true">
      <!-- Erizo buscando -->
      <path fill="currentColor" d="M30 96 38 58l12 14 6-34 14 24 10-34 12 30 14-22 4 28 16-14 6 26c10 2 20 8 20 20z"/>
      <circle cx="160" cy="88" r="4" fill="var(--bg)"/>
      <circle cx="198" cy="64" r="16" fill="none" stroke="var(--ink)" stroke-width="6"/>
      <path d="m210 76 16 16" stroke="var(--ink)" stroke-width="8" stroke-linecap="round"/>
      <rect x="30" y="100" width="150" height="6" rx="3" fill="currentColor" opacity=".35"/>
    </svg>
    <p class="notfound__code">404</p>
    <h1>Esta página se ha escondido</h1>
    <p class="lead">Puede que haya cambiado de dirección al renovar la web. Prueba a buscarla o vuelve a una de las secciones principales.</p>
    <form role="search" onsubmit="event.preventDefault();document.querySelector('[data-open-search]').click()">
      <label class="sr-only" for="q404">Buscar</label>
      <input id="q404" type="search" placeholder="¿Qué estabas buscando?">
      <button class="btn" type="submit"><svg aria-hidden="true"><use href="#i-search"/></svg> Buscar</button>
    </form>
    <ul class="chips">
      <li><a class="chip" href={url("portada.html")}>Inicio</a></li>
      <li><a class="chip" data-section="hardware" href={url("indice-seccion.html")}>Hardware</a></li>
      <li><a class="chip" data-section="didactica" href={url("actividad.html")}>Actividades</a></li>
      <li><a class="chip" data-section="programar" href="#">A programar</a></li>
      <li><a class="chip" data-section="blog" href={url("listado.html")}>Blog</a></li>
    </ul>
  </section>
</main>
</Base>

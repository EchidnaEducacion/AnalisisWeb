---
import { url } from '../lib/url';
import Base from '../layouts/Base.astro';
---
<Base
  title="Página no encontrada"
  description="La página que buscas no existe o ha cambiado de dirección."
>
<main id="contenido">
  <!-- Plantilla: Error 404. Los enlaces van a las mismas direcciones que el menú -->
  <section class="wrap notfound">
    <svg class="notfound__art" viewBox="0 0 300 140" aria-hidden="true">
      <!-- El erizo del logo, buscando con la lupa -->
      <ellipse cx="110" cy="128" rx="100" ry="7" fill="currentColor" opacity=".18"/>
      <use href="#i-echidna" x="0" y="8" width="212" height="120"/>
      <circle cx="252" cy="70" r="20" fill="none" stroke="var(--ink)" stroke-width="7"/>
      <path d="m266 85 18 18" stroke="var(--ink)" stroke-width="9" stroke-linecap="round"/>
    </svg>
    <p class="notfound__code">404</p>
    <h1>Esta página se ha escondido</h1>
    <p class="lead">Puede que haya cambiado de dirección al renovar la web. Prueba a buscarla o vuelve a una de las secciones principales.</p>
    <form role="search" data-search-form>
      <label class="sr-only" for="q404">Buscar</label>
      <input id="q404" type="search" placeholder="¿Qué estabas buscando?">
      <button class="btn" type="submit"><svg aria-hidden="true"><use href="#i-search"/></svg> Buscar</button>
    </form>
    <ul class="chips">
      <li><a class="chip" href={url("maquetas/portada/")}>Inicio</a></li>
      <li><a class="chip" data-section="ecosistema" href={url("ecosistema/")}>Ecosistema</a></li>
      <li><a class="chip" data-section="alumnado" href={url("maquetas/alumnado/")}>Materiales alumnado</a></li>
      <li><a class="chip" data-section="docentes" href={url("maquetas/docentes/")}>Recursos docentes</a></li>
      <li><a class="chip" data-section="blog" href={url("blog/")}>Blog</a></li>
    </ul>
  </section>
</main>
</Base>

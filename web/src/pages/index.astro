---
// Portada (/): héroe, entradas por perfil, qué es Echidna, la placa y EchidnaML, materiales destacados, últimas
// entradas del blog y llamada a colaborar. Los textos van aquí; la placa, EchidnaML, los materiales y
// las entradas salen de sus colecciones, así que se actualizan solos.
import { Image } from 'astro:assets';
import { getCollection, getEntries, getEntry } from 'astro:content';
import Base from '../layouts/Base.astro';
import { url } from '../lib/url';
import { entradasPublicadas, fechaLarga, rutaEntrada } from '../lib/blog';
import { sitio } from '../lib/recursos';

// La placa, con la imagen y la descripción de su ficha
const placa = await getEntry('hardware', 'es/echidnablack2');
if (!placa) throw new Error('Falta la ficha de la EchidnaBlack2 (hardware/es/echidnablack2)');
// El programa, con la imagen y la descripción de su página
const programa = await getEntry('paginas', 'es/ecosistema/echidnaml');
if (!programa?.data.image) throw new Error('Falta la página de EchidnaML (paginas/es/ecosistema/echidnaml) o su imagen');

// Materiales destacados, en este orden (ids de recursos.yaml)
const DESTACADOS = ['guia-inicio-echidnaml', 'hace-calor-aqui', 'manual-echidnaml'];
const recursos = await getCollection('recursos');
const destacados = DESTACADOS.map((id) => {
  const r = recursos.find((x) => x.id === id);
  if (!r) throw new Error(`Portada: no existe el recurso «${id}» en recursos.yaml`);
  return r.data;
});
// Las rutas internas llevan base; las URL externas, no
const enlace = (href: string) => (href.startsWith('/') ? url(href.slice(1)) : href);

// Las tres entradas más recientes del blog
const ultimas = await Promise.all(
  (await entradasPublicadas()).slice(0, 3).map(async (e) => ({
    entry: e,
    categorias: await getEntries(e.data.categories),
  })),
);
---
<Base
  title="Echidna Educación · Programación, robótica e inteligencia artificial en el aula"
  description="La placa EchidnaBlack2, el entorno EchidnaML y materiales libres, creados por docentes para llevar el pensamiento computacional al aula."
  bare
>
<main id="contenido">

  <!-- Héroe -->
  <section class="hero">
    <div class="wrap hero__grid">
      <div>
        <p class="eyebrow">Proyecto educativo libre</p>
        <h1>Aprende a programar <em>tocando</em> el mundo real</h1>
        <p class="lead">Una placa, un entorno de programación y materiales libres, creados por docentes para desarrollar el pensamiento computacional en el aula.</p>
        <div class="btn-row">
          <a class="btn" href={url('alumnado/')}>Ver materiales <svg aria-hidden="true"><use href="#i-arrow-right"/></svg></a>
          <a class="btn btn--ghost" href={url('ecosistema/echidnaml/descarga/')}>Descarga EchidnaML</a>
        </div>
        <div class="hero__badges">
          <span><svg aria-hidden="true"><use href="#i-check"/></svg>Hardware y software libres</span>
          <span><svg aria-hidden="true"><use href="#i-check"/></svg>De Primaria a FP</span>
          <span><svg aria-hidden="true"><use href="#i-check"/></svg>Bloques, IA o código</span>
        </div>
      </div>
      <div class="hero__art">
        <Image class="board" src={placa.data.image!} alt={placa.data.imageAlt ?? ''} widths={[480, 960]} sizes="(min-width: 900px) 520px, 100vw" loading="eager" />
      </div>
    </div>
  </section>

  <!-- Entradas por perfil -->
  <section class="wrap" aria-label="¿Por dónde empiezo?">
    <div class="paths">
      <a class="path" href={url('docentes/')} data-section="docentes">
        <span class="path__icon"><svg aria-hidden="true"><use href="#i-teacher"/></svg></span>
        <strong>Soy docente</strong>
        <span>Guías, diapositivas y programaciones para llevar la placa al aula, organizadas por material.</span>
      </a>
      <a class="path" href={url('alumnado/')} data-section="alumnado">
        <span class="path__icon"><svg aria-hidden="true"><use href="#i-student"/></svg></span>
        <strong>Soy estudiante</strong>
        <span>Proyectos de inicio y situaciones de aprendizaje para hacer con la placa.</span>
      </a>
      <a class="path" href={url('ecosistema/echidnablack2/')} data-section="ecosistema">
        <span class="path__icon"><svg aria-hidden="true"><use href="#i-chip"/></svg></span>
        <strong>Conoce la EchidnaBlack2</strong>
        <span>La placa con sensores y actuadores integrados, lista para programar.</span>
      </a>
    </div>
  </section>

  <!-- Qué es Echidna -->
  <section class="section">
    <div class="wrap">
      <div class="section-head">
        <div>
          <p class="eyebrow">Qué es Echidna</p>
          <h2>Todo lo que necesitas para programar dispositivos físicos</h2>
        </div>
        <p>Un proyecto pensado desde el aula para que el alumnado aprenda programando cosas que se ven, se oyen y se mueven.</p>
      </div>
      <div class="grid grid--4">
        <article class="feature" data-section="ecosistema">
          <div class="feature__icon"><svg aria-hidden="true"><use href="#i-chip"/></svg></div>
          <h3><a href={url('ecosistema/echidnablack2/')}>EchidnaBlack2</a></h3>
          <p>Placa autónoma compatible con Arduino, con sensores y actuadores integrados: sin cables ni protoboard.</p>
        </article>
        <article class="feature" data-section="ecosistema">
          <div class="feature__icon"><svg aria-hidden="true"><use href="#i-blocks"/></svg></div>
          <h3><a href={url('ecosistema/echidnaml/')}>EchidnaML</a></h3>
          <p>Programación por bloques e inteligencia artificial en un solo entorno. La placa también se programa con Snap! y Arduino IDE.</p>
        </article>
        <article class="feature" data-section="alumnado">
          <div class="feature__icon"><svg aria-hidden="true"><use href="#i-cap"/></svg></div>
          <h3><a href={url('alumnado/')}>Materiales para el aula</a></h3>
          <p>Para el alumnado y para docentes, con licencia CC BY-SA 4.0.</p>
        </article>
        <article class="feature" data-section="nosotros">
          <div class="feature__icon"><svg aria-hidden="true"><use href="#i-users"/></svg></div>
          <h3><a href={url('quienes-somos/')}>Equipo docente</a></h3>
          <p>Una asociación sin ánimo de lucro de profesores y profesoras que comparte lo que funciona en clase.</p>
        </article>
      </div>
    </div>
  </section>

  <!-- La placa y el programa -->
  <section class="section section--tint" data-section="ecosistema">
    <div class="wrap">
      <div class="section-head">
        <div>
          <p class="eyebrow">Ecosistema</p>
          <h2>La placa EchidnaBlack2 y el programa EchidnaML</h2>
        </div>
        <a class="btn btn--ghost btn--sm" href={url('ecosistema/')}>Todo el ecosistema <svg aria-hidden="true"><use href="#i-arrow-right"/></svg></a>
      </div>
      <div class="grid grid--2">
        <article class="board-card">
          <div class="board-card__head">
            <Image src={placa.data.image!} alt="" widths={[200, 400]} sizes="(min-width: 520px) 160px, 200px" />
            <div>
              <h3>EchidnaBlack2</h3>
              <p class="muted">{placa.data.description}</p>
            </div>
          </div>
          <ul>
            <li>LED, LED RGB, audio y pulsadores</li>
            <li>Joystick, acelerómetro y sensores de luz, temperatura y sonido</li>
            <li>Entradas MkMk para convertir objetos en botones</li>
          </ul>
          <a class="btn btn--soft btn--sm" href={url('ecosistema/echidnablack2/')}>Conocer la EchidnaBlack2</a>
        </article>
        <article class="board-card">
          <div class="board-card__head">
            <Image src={programa.data.image} alt="" widths={[200, 400]} sizes="(min-width: 520px) 160px, 200px" />
            <div>
              <h3>EchidnaML</h3>
              <p class="muted">{programa.data.description}</p>
            </div>
          </div>
          <ul>
            <li>EchidnaBlocks: Scratch con bloques para la placa</li>
            <li>LearningML: modelos de inteligencia artificial sin salir del programa</li>
            <li>Para GNU/Linux, Windows y macOS, y funciona sin conexión</li>
          </ul>
          <a class="btn btn--soft btn--sm" href={url('ecosistema/echidnaml/')}>Conocer EchidnaML</a>
        </article>
      </div>
    </div>
  </section>

  <!-- Materiales destacados -->
  <section class="section" data-section="alumnado">
    <div class="wrap">
      <div class="section-head">
        <div>
          <p class="eyebrow">Para el aula</p>
          <h2>Materiales para empezar</h2>
        </div>
        <div class="btn-row">
          <a class="btn btn--ghost btn--sm" href={url('alumnado/')}>Materiales alumnado <svg aria-hidden="true"><use href="#i-arrow-right"/></svg></a>
          <a class="btn btn--ghost btn--sm" href={url('docentes/')}>Recursos docentes <svg aria-hidden="true"><use href="#i-arrow-right"/></svg></a>
        </div>
      </div>
      <ul class="img-cards recursos grid grid--3">
        {destacados.map((r) => (
          <li class="card post-card">
            {r.image && (
              <div class="post-thumb">
                <Image src={r.image} alt="" widths={[400, 800]} sizes="(min-width: 960px) 380px, 100vw" />
              </div>
            )}
            <div class="card__body">
              <p class="recursos__tags">
                <span class="chip">{r.type}</span>
                {r.level && <span class="chip chip--outline">{r.level}</span>}
              </p>
              <h3 class="card__title"><a class="card__link" href={enlace(r.url!)}>{r.title}</a></h3>
              <p class="card__text">{r.description}</p>
              {sitio(r.url) && <p class="recursos__sitio">{sitio(r.url)} ↗</p>}
            </div>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <!-- Últimas entradas del blog -->
  <section class="section section--tint" data-section="blog">
    <div class="wrap">
      <div class="section-head">
        <div>
          <p class="eyebrow">Blog</p>
          <h2>Últimas entradas</h2>
        </div>
        <a class="btn btn--ghost btn--sm" href={url('blog/')}>Ver todas <svg aria-hidden="true"><use href="#i-arrow-right"/></svg></a>
      </div>
      <ul class="img-cards grid grid--3">
        {ultimas.map(({ entry, categorias }) => (
          <li class="card post-card">
            {entry.data.image && (
              <div class="post-thumb">
                <Image src={entry.data.image} alt="" widths={[400, 800]} sizes="(min-width: 960px) 380px, 100vw" />
              </div>
            )}
            <div class="card__body">
              <p class="recursos__tags">{categorias.slice(0, 2).map((c) => <span class="chip">{c.data.name}</span>)}</p>
              <h3 class="card__title"><a class="card__link" href={url(`${rutaEntrada(entry)}/`)}>{entry.data.title}</a></h3>
              <p class="card__meta"><time datetime={entry.data.date.toISOString().slice(0, 10)}>{fechaLarga(entry.data.date)}</time></p>
            </div>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <!-- Colaborar -->
  <section class="section">
    <div class="wrap">
      <div class="band">
        <div>
          <h2>Libre para usar, copiar y mejorar</h2>
          <p>Los diseños de la placa, el software y los materiales están en GitHub. Imprime las piezas en 3D, adapta los materiales a tu clase y comparte tus propuestas.</p>
        </div>
        <div class="btn-row">
          <a class="btn" href="https://github.com/EchidnaEducacion"><svg aria-hidden="true"><use href="#i-github"/></svg> GitHub</a>
          <a class="btn btn--ghost" href={url('docentes/colabora/')}>Cómo colaborar</a>
        </div>
      </div>
    </div>
  </section>
</main>
</Base>

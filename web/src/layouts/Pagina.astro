---
// Plantilla «Página genérica»: título, entradilla, cuerpo Markdown y, si la página lo pide,
// índice lateral con los h2 (toc) y fichas del equipo al final (team)
import type { MarkdownHeading } from 'astro';
import Base from './Base.astro';
import CabeceraPagina from '../components/CabeceraPagina.astro';
import Equipo from '../components/Equipo.astro';

interface Props {
  title: string;
  description: string;
  section?: string;
  /** Tramos intermedios de las migas de pan (sin Inicio ni la página actual) */
  crumbs?: { title: string; href: string }[];
  headings: MarkdownHeading[];
  /** Equipo que se muestra después del texto */
  team?: { collection: 'autores'; id: string }[];
}
const { title, description, section, crumbs = [], headings, team } = Astro.props;
const toc = headings.filter((h) => h.depth === 2);
---
<Base title={title} description={description} section={section}>
<main id="contenido">
  <CabeceraPagina title={title} description={description} crumbs={crumbs} />

  <div class={toc.length ? 'wrap with-aside with-aside--left' : 'wrap with-aside'}>
    {toc.length > 0 && (
      <nav class="toc" aria-label="En esta página">
        <h2>En esta página</h2>
        <ol>
          {toc.map((h) => <li><a href={`#${h.slug}`}>{h.text}</a></li>)}
        </ol>
      </nav>
    )}
    <article class="prose">
      <slot />
      {team && <Equipo ids={team} />}
    </article>
  </div>
</main>
</Base>

---
// Plantilla «Página genérica»: título, entradilla, índice lateral con los h2 y cuerpo Markdown
import type { MarkdownHeading } from 'astro';
import Base from './Base.astro';
import { url } from '../lib/url';

interface Props {
  title: string;
  description: string;
  section?: string;
  /** Tramos intermedios de las migas de pan (sin Inicio ni la página actual) */
  crumbs?: { title: string; href: string }[];
  headings: MarkdownHeading[];
}
const { title, description, section, crumbs = [], headings } = Astro.props;
const toc = headings.filter((h) => h.depth === 2);
---
<Base title={title} description={description} section={section}>
<main id="contenido">
  <header class="page-hero">
    <div class="wrap">
      <nav class="breadcrumb" aria-label="Migas de pan">
        <ol>
          <li><a href={url()}>Inicio</a></li>
          {crumbs.map((c) => <li><a href={c.href}>{c.title}</a></li>)}
          <li><span aria-current="page">{title}</span></li>
        </ol>
      </nav>
      <h1>{title}</h1>
      <p class="lead">{description}</p>
    </div>
  </header>

  <div class={toc.length ? 'wrap with-aside with-aside--left' : 'wrap with-aside'}>
    {toc.length > 0 && (
      <nav class="toc" aria-label="En esta página">
        <h2>En esta página</h2>
        <ol>
          {toc.map((h) => <li><a href={`#${h.slug}`}>{h.text}</a></li>)}
        </ol>
      </nav>
    )}
    <article class="prose">
      <slot />
    </article>
  </div>
</main>
</Base>

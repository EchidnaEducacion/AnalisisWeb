---
// Plantilla «Página genérica»: título, entradilla, cuerpo Markdown y, si la página lo pide,
// índice lateral con los h2 (toc), fichas del equipo (team), tarjetas de enlace (cards) y la lista de
// publicaciones (publications) al final
import type { ImageMetadata, MarkdownHeading } from 'astro';
import Base from './Base.astro';
import CabeceraPagina from '../components/CabeceraPagina.astro';
import Equipo from '../components/Equipo.astro';
import Publicaciones from '../components/Publicaciones.astro';
import Recursos from '../components/Recursos.astro';
import Tarjetas from '../components/Tarjetas.astro';
import { anclaEntorno, recursosPorEntorno } from '../lib/recursos';
import { publicacionesPorAño } from '../lib/publicaciones';

interface Props {
  title: string;
  description: string;
  section?: string;
  /** Tramos intermedios de las migas de pan (sin Inicio ni la página actual) */
  crumbs?: { title: string; href: string }[];
  headings: MarkdownHeading[];
  /** Equipo que se muestra después del texto */
  team?: { collection: 'autores'; id: string }[];
  /** Tarjetas de enlace que se muestran después del texto */
  cards?: { title: string; text: string; href: string; image?: ImageMetadata }[];
  /** Importancia mínima de las publicaciones que se listan al final; sin valor, no hay lista */
  publications?: number;
  /** Público de los recursos que se listan al final, agrupados por entorno; sin valor, no hay lista */
  resources?: 'alumnado' | 'docentes';
  /** Si la página lleva índice lateral (toc) */
  conIndice?: boolean;
  /** Tarjeta lateral de resumen; solo en páginas sin índice lateral */
  summary?: { label: string; value: string }[];
}
const { title, description, section, crumbs = [], headings, team, cards = [], publications, resources, conIndice = false, summary = [] } = Astro.props;
// Índice: los h2 del Markdown y, si hay lista de publicaciones, sus años
const años = publications ? (await publicacionesPorAño(publications)).map((g) => g.año) : [];
const entornos = resources ? (await recursosPorEntorno(resources)).map((g) => g.entorno) : [];
// Sin lateral, los recursos salen debajo, a todo el ancho, para que quepan tres tarjetas por fila
const recursosAncho = Boolean(resources) && !conIndice && summary.length === 0;
// Igual con las tarjetas con imagen (Modelos e impresión 3D): a todo el ancho, tres por fila
const tarjetasAncho = cards.some((c) => c.image) && !conIndice && summary.length === 0;
const toc = [
  ...headings.filter((h) => h.depth === 2),
  ...(conIndice ? años.map((a) => ({ slug: `año-${a}`, text: a })) : []),
  ...(conIndice ? entornos.map((e) => ({ slug: anclaEntorno(e), text: e })) : []),
];
---
<Base title={title} description={description} section={section}>
<main id="contenido">
  <CabeceraPagina title={title} description={description} crumbs={crumbs} />

  <div class={toc.length ? 'wrap with-aside with-aside--left' : summary.length ? 'wrap with-aside with-aside--facts-first' : 'wrap with-aside'}>
    {toc.length > 0 && (
      <nav class="toc" aria-label="En esta página">
        <h2>En esta página</h2>
        <ol>
          {toc.map((h) => <li><a href={`#${h.slug}`}>{h.text}</a></li>)}
        </ol>
      </nav>
    )}
    <article class="prose">
      <slot />
      {team && <Equipo ids={team} />}
      {cards.length > 0 && !tarjetasAncho && <Tarjetas cards={cards} />}
      {publications && <Publicaciones minimo={publications} />}
      {resources && !recursosAncho && <Recursos publico={resources} />}
    </article>
    {summary.length > 0 && toc.length === 0 && (
      <aside class="aside-stack aside-stack--sticky">
        <section class="factsheet" aria-labelledby="resumen-t">
          <h2 id="resumen-t">En resumen</h2>
          <dl>
            {summary.map((s) => <div><dt>{s.label}</dt><dd>{s.value}</dd></div>)}
          </dl>
        </section>
      </aside>
    )}
  </div>
  {tarjetasAncho && (
    <div class="wrap recursos-ancho">
      <Tarjetas cards={cards} columnas={3} />
    </div>
  )}
  {recursosAncho && (
    <div class="wrap recursos-ancho">
      <div class="prose prose--ancha">
        <Recursos publico={resources!} />
      </div>
    </div>
  )}
</main>
</Base>

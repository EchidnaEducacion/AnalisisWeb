---
// Layout Base: <head>, iconos, cabecera, pie y scripts comunes a todas las plantillas
import Iconos from '../components/Iconos.astro';
import Cabecera from '../components/Cabecera.astro';
import Pie from '../components/Pie.astro';
import { Font } from 'astro:assets';
import { url } from '../lib/url';

interface Props {
  title: string;
  description?: string;
  /** Sección del menú: color de acento y entrada activa */
  section?: string;
  /** Usa el título tal cual, sin añadir « · Echidna Educación» */
  bare?: boolean;
}
const { title, description = '', section, bare = false } = Astro.props;
const fullTitle = bare ? title : `${title} · Echidna Educación`;
// Para compartir en redes (Open Graph): direcciones absolutas, con el dominio de `site`
const canonica = new URL(Astro.url.pathname, Astro.site).href;
const imagenRedes = new URL(url('imagen-redes.png'), Astro.site).href;
---
<!doctype html>
<html lang="es">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>{fullTitle}</title>
<meta name="description" content={description}>
<link rel="canonical" href={canonica}>
<meta property="og:type" content="website">
<meta property="og:site_name" content="Echidna Educación">
<meta property="og:locale" content="es_ES">
<meta property="og:url" content={canonica}>
<meta property="og:title" content={fullTitle}>
{description && <meta property="og:description" content={description}>}
<!-- Imagen al compartir (1200 × 630): la genera `bun run imagen-redes` a partir del logo -->
<meta property="og:image" content={imagenRedes}>
<meta property="og:image:width" content="1200">
<meta property="og:image:height" content="630">
<meta property="og:image:alt" content="Logo de Echidna: un equidna naranja con el nombre «Echidna»">
<meta name="twitter:card" content="summary_large_image">
{section && <meta data-pagefind-meta="seccion[content]" content={section}>}
<link rel="icon" href={url("favicon.svg")} type="image/svg+xml">
<link rel="apple-touch-icon" href={url("apple-touch-icon.png")}>
<link rel="alternate" type="application/rss+xml" title="Blog de Echidna Educación" href={url("rss.xml")}>
<link rel="alternate" hreflang="en" href="#">
<script is:inline>try{var t=localStorage.getItem('echidna-theme');if(t)document.documentElement.dataset.theme=t}catch(e){}</script>
<!-- Tipografías servidas desde la propia web (ver «tipografias» en astro.config.mjs) -->
<Font cssVariable="--font-body" preload={[{ weight: '400', style: 'normal' }]} />
<Font cssVariable="--font-head" preload />
<Font cssVariable="--font-mono" />
<Font cssVariable="--font-brand" />
<link rel="stylesheet" href={url("assets/css/echidna.css")}>
</head>
<body data-section={section}>
<div class="page">
<Iconos />
<Cabecera section={section} />
<slot />
<Pie />
<script is:inline src={url("assets/js/echidna.js")}></script>
</div>
</body>
</html>

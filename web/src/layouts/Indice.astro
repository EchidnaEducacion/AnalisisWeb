---
// Plantilla «Índice de sección»: cabecera, introducción en Markdown y una tarjeta por cada
// página hija directa que exista (salvo las que llevan `listed: false`), sea de `paginas` o una ficha de `hardware`, por `order`.
// Con `toc`, un índice lateral con los apartados del texto y enlaces directos a las hijas.
import type { MarkdownHeading } from 'astro';
import { Image } from 'astro:assets';
import { getCollection, type CollectionEntry } from 'astro:content';
import Base from './Base.astro';
import CabeceraPagina from '../components/CabeceraPagina.astro';
import { url } from '../lib/url';
import { rutaDe } from '../lib/paginas';
import { rutaHardware } from '../lib/hardware';

interface Props {
  title: string;
  description: string;
  section?: string;
  /** Tramos intermedios de las migas de pan (sin Inicio ni la página actual) */
  crumbs?: { title: string; href: string }[];
  /** URL del índice sin base ni barras: ecosistema */
  ruta: string;
  /** Apartados del texto para el índice lateral; vacío si la página no lleva `toc` */
  headings?: MarkdownHeading[];
  /** Título del apartado de tarjetas de las hijas; sin él, las tarjetas van sin título */
  cardsTitle?: string;
}
const { title, description, section, crumbs = [], ruta, headings = [], cardsTitle } = Astro.props;

type Hija = { ruta: string; data: CollectionEntry<'paginas'>['data'] | CollectionEntry<'hardware'>['data'] };
const esHija = (r: string) => r.startsWith(`${ruta}/`) && !r.slice(ruta.length + 1).includes('/');
const paginas = await getCollection('paginas', (p) => p.id.startsWith('es/') && !p.data.draft);
const fichas = await getCollection('hardware', (h) => h.id.startsWith('es/') && !h.data.draft);
const hijas: Hija[] = [
  ...paginas.map((p) => ({ ruta: rutaDe(p), data: p.data })),
  ...fichas.map((h) => ({ ruta: rutaHardware(h), data: h.data })),
]
  .filter((h) => esHija(h.ruta) && (!('listed' in h.data) || h.data.listed))
  .sort((a, b) => a.data.order - b.data.order || a.data.title.localeCompare(b.data.title, 'es'));
// Apartados de tarjetas: primero las hijas sin grupo (con cardsTitle, si lo hay) y después un apartado
// por cada grupo, en el orden de su primera hija. Con título de apartado, las tarjetas llevan h3.
const grupo = (h: Hija) => ('group' in h.data ? h.data.group : undefined);
const anclaGrupo = (g: string) =>
  g.toLowerCase().normalize('NFD').replace(/[\u0300-\u036f]/g, '').replace(/[^a-z0-9]+/g, '-').replace(/^-|-$/g, '');
const sinGrupo = hijas.filter((h) => !grupo(h));
const apartados = [
  ...(sinGrupo.length ? [{ titulo: cardsTitle, id: 'paginas-hijas', lista: sinGrupo }] : []),
  ...[...new Set(hijas.map(grupo).filter((g): g is string => Boolean(g)))].map((g) => ({
    titulo: g,
    id: anclaGrupo(g),
    lista: hijas.filter((h) => grupo(h) === g),
  })),
];
const toc = [
  ...headings.filter((h) => h.depth === 2),
  ...apartados.filter((a) => a.titulo).map((a) => ({ slug: a.id, text: a.titulo! })),
];
const conIndice = headings.length > 0;
---
<Base title={title} description={description} section={section}>
<main id="contenido">
  <CabeceraPagina title={title} description={description} crumbs={crumbs} />

  <div class={conIndice ? 'wrap indice with-aside with-aside--left' : 'wrap indice'}>
    {conIndice && (
      <div class="toc-stack">
        {hijas.length > 0 && (
          <nav class="toc" aria-label={`Páginas de ${title}`}>
            <h2>Páginas de {title}</h2>
            <ol>
              {hijas.map((h) => <li><a href={url(`${h.ruta}/`)}>{h.data.title}</a></li>)}
            </ol>
          </nav>
        )}
        {toc.length > 0 && (
          <nav class="toc" aria-label="En esta página">
            <h2>En esta página</h2>
            <ol>
              {toc.map((h) => <li><a href={`#${h.slug}`}>{h.text}</a></li>)}
            </ol>
          </nav>
        )}
      </div>
    )}
    <div class="indice__main">
    <div class="prose">
      <slot />
    </div>

    {apartados.map(({ titulo, id, lista }) => {
      const TituloTarjeta = titulo ? 'h3' : 'h2';
      return (
      <>
      {titulo && <h2 class="indice__cards-title" id={id}>{titulo}</h2>}
      <ul class="img-cards grid grid--3">
        {lista.map((h) => (
          <li class="card">
            {h.data.image && (
              <div class="img-cards__img">
                <Image src={h.data.image} alt="" widths={[320, 640]} sizes="320px" />
              </div>
            )}
            <div class="card__body">
              <TituloTarjeta class="card__title"><a class="card__link" href={url(`${h.ruta}/`)}>{h.data.title}</a></TituloTarjeta>
              <p class="card__text">{h.data.description}</p>
            </div>
          </li>
        ))}
      </ul>
      </>
      );
    })}
    </div>
  </div>
</main>
</Base>
